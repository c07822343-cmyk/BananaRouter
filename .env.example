# ---------------------------------------------------------------------------
# OpenRouter Workspace — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (development) or set these as real server
# environment variables (production). Never commit `.env.local`.
#
#   cp .env.example .env.local
#
# OpenRouter API key. Create one at https://openrouter.ai/keys.
# This is used ONLY by the server. It is never sent to the browser, never
# stored in localStorage, and never logged. If you think a key was exposed,
# rotate it immediately at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OpenRouter model router. Default used when no model is selected in the UI.
# `openrouter/free` routes to the best available free model. `openrouter/auto` is also supported.
OPENROUTER_MODEL=openrouter/free

# Application branding. Changing these updates the UI centrally.
APP_NAME=OpenRouter Workspace
APP_DESCRIPTION=One AI workspace for thinking, creating, organizing, researching, and working with information.

# Optional: source origin header sent to OpenRouter (HTTP-Referer / X-Title).
APP_URL=http://localhost:3000

# Optional server-side defaults (the UI can override these per chat).
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TIMEOUT_MS=120000
OSS_APP_VERSION=1.0.0
