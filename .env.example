# ---------------------------------------------------------------------------
# OpenRouter Chat — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (development) or set these as real server
# environment variables (production). Never commit `.env.local`.
#
#   cp .env.example .env.local
#
# OpenRouter API key. Create one at https://openrouter.ai/keys.
# This is used ONLY by the server. It is never sent to the browser.
OPENROUTER_API_KEY=

# OpenRouter model router. This is the default used when no model is selected
# in the UI. `openrouter/free` routes to the best available free model.
OPENROUTER_MODEL=openrouter/free

# Optional: display name and source origin headers sent to OpenRouter.
APP_NAME=OpenRouter Chat
APP_URL=http://localhost:3000

# Optional server-side defaults (the UI can override these per chat).
OPENROUTER_TEMPERATURE=0.7
